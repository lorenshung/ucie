import mill._
import mill.scalalib._

object Deps {
  val scalaVersion = "2.13.16"
  val chisel       = mvn"org.chipsalliance::chisel:6.7.0"
  val chiselPlugin = mvn"org.chipsalliance:::chisel-plugin:6.7.0"
  val chiseltest   = mvn"edu.berkeley.cs::chiseltest:6.0.0"
}

trait CommonModule extends ScalaModule {
  override def scalaVersion = Deps.scalaVersion
  override def scalacOptions = Seq("-Ymacro-annotations")
}

trait HasChisel extends ScalaModule {
  override def mvnDeps = super.mvnDeps() ++ Seq(Deps.chisel)
  override def scalacPluginMvnDeps = Seq(Deps.chiselPlugin)
}

/**
 * Root module so you can run `./mill compile` and `./mill test`.
 *
 * Uses sbt-style layout under the repo root:
 * - src/main/scala
 * - src/test/scala
 */
object `package` extends SbtModule with CommonModule with HasChisel {
  object test extends SbtTests with TestModule.ScalaTest {
    override def mvnDeps = super.mvnDeps() ++ Seq(Deps.chiseltest)
    def testParallelism = false
  }
}


